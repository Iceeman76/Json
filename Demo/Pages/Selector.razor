@page "/"

<PageTitle>JSON Selector</PageTitle>

<div class="info-banner">
    <label class="query-label" for="example-select">Samples</label>
    <select id="example-select" class="form-select" @onchange="OnExampleSelected">
        <option value="">Choose an example…</option>
        @foreach (var example in Examples)
        {
            <option value="@example.Name">@example.Name</option>
        }
    </select>
    <button class="btn btn-secondary cheat-toggle" type="button" @onclick="ToggleCheatSheet">
        @(ShowCheatSheet ? "Hide cheat sheet" : "Cheat sheet")
    </button>
</div>

@if (ShowCheatSheet)
{
    <div class="cheat-sheet">
        <table class="cheat-table">
            <thead>
                <tr>
                    <th>Expression</th>
                    <th>Returns</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in CheatSheet)
                {
                    <tr @onclick="() => ApplyCheatExpression(row.Expression)">
                        <td><code>@row.Expression</code></td>
                        <td>@row.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<section class="panel select-panel">
    <div class="panel-body">
        <div class="d-flex gap-2 align-items-center">
            <span class="query-label">Query</span>
            <input id="selector-input" class="form-control font-monospace"
                   @bind="SelectorInput" @bind:event="oninput" @bind:after="ApplySelector"
                   autocomplete="off"
                   placeholder="$.items" />
            <button class="btn btn-secondary copy-btn @(QueryCopied ? "copied" : "")"
                    type="button"
                    title="Copy query"
                    aria-label="Copy query"
                    disabled="@(string.IsNullOrEmpty(SelectorInput))"
                    @onclick="CopyQuery">
                @if (QueryCopied)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                }
            </button>
            <button class="btn btn-secondary" @onclick="ClearInputs">Clear</button>
        </div>
    </div>
</section>

<div class="editor-row">
    <div class="editor-col">
        <section class="panel">
            <div class="panel-header d-flex justify-content-between align-items-center">
                <span class="d-flex align-items-center gap-2">
                    <span>JSON Data</span>
                    <span class="validity @(JsonValid == true ? "valid" : JsonValid == false ? "invalid" : "")"
                          title="@(JsonValid == true ? "Valid JSON" : JsonValid == false ? "Invalid JSON" : "")"></span>
                    @if (!string.IsNullOrEmpty(JsonSizeMeta))
                    {
                        <span class="result-meta">@JsonSizeMeta</span>
                    }
                </span>
                <span class="d-flex align-items-center gap-1">
                <button class="btn btn-secondary json-tool-btn" type="button" title="Format JSON"
                        @onclick="FormatJson">Format</button>
                <button class="btn btn-secondary json-tool-btn" type="button" title="Minify JSON"
                        @onclick="MinifyJson">Minify</button>
                <button class="btn btn-secondary copy-btn @(JsonPasted ? "copied" : "")"
                        type="button"
                        title="Paste JSON"
                        aria-label="Paste JSON"
                        @onclick="PasteJson">
                    @if (JsonPasted)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                            <rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
                        </svg>
                    }
                </button>
                </span>
            </div>
            <div class="panel-body">
                <div class="code-wrap">
                    <div id="json-gutter" class="line-gutter">@InputGutter</div>
                    <textarea id="json-input" class="form-control font-monospace"
                              @bind="JsonInput" @bind:event="oninput" @bind:after="ApplySelector"
                              placeholder='{ "name": "Junie", "items": [1, 2, 3] }'></textarea>
                </div>
            </div>
        </section>
    </div>
    <div class="editor-col">
        <section class="panel">
            <div class="panel-header d-flex justify-content-between align-items-center">
                <span class="d-flex align-items-center gap-2">
                    <span>Query Result</span>
                    @if (!string.IsNullOrEmpty(ResultMeta))
                    {
                        <span class="result-meta">@ResultMeta</span>
                    }
                    @if (!string.IsNullOrEmpty(ResultSizeMeta))
                    {
                        <span class="result-meta">@ResultSizeMeta</span>
                    }
                </span>
                <span class="d-flex align-items-center gap-1">
                    <button class="btn btn-secondary json-tool-btn" type="button" title="Format result"
                            @onclick="FormatResult">Format</button>
                    <button class="btn btn-secondary json-tool-btn" type="button" title="Minify result"
                            @onclick="MinifyResult">Minify</button>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button"
                                class="btn @(View == ResultView.Json ? "btn-primary" : "btn-secondary")"
                                @onclick="() => SetView(ResultView.Json)">JSON</button>
                        <button type="button"
                                class="btn @(View == ResultView.Tree ? "btn-primary" : "btn-secondary")"
                                @onclick="() => SetView(ResultView.Tree)">Tree</button>
                    </div>
                </span>
            </div>
            <div class="panel-body">
                <div class="code-wrap">
                    <div id="output-gutter" class="line-gutter">@OutputGutter</div>
                    <pre id="result-output"
                         class="form-control font-monospace json-output @(ErrorMessage is not null ? "output-error" : "")">@HighlightedOutput</pre>
                </div>
            </div>
        </section>
    </div>
</div>
